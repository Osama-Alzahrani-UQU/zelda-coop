// Longshot Co-op Setup: the icon, the manifest, the version, and the mod's two files (built first by build.ps1)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "setup.ico"
1 RT_MANIFEST "setup.manifest"

IDR_WINMM_DLL RCDATA "../build/winmm.dll"
IDR_COOP_DLL RCDATA "../build/coop/LongshotCoop.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,2,0
PRODUCTVERSION 1,1,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Longshot Co-op Setup - Zelda Multiplayer Mod"
            VALUE "ProductName", "Longshot Co-op"
            VALUE "CompanyName", "Osama-Alzahrani-UQU"
            VALUE "LegalCopyright", "Copyright (C) 2026 Osama-Alzahrani-UQU. All rights reserved."
            VALUE "FileVersion", "1.1.2"
            VALUE "ProductVersion", "1.1.2 Beta"
            VALUE "OriginalFilename", "LongshotCoop-Setup.exe"
            VALUE "Comments", "Created by Osama-Alzahrani-UQU - https://github.com/Osama-Alzahrani-UQU/zelda-coop"
            VALUE "Support", "https://paypal.me/onlinerp53"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
